{
  "name": "@threenine/nuxt-fathom",
  "version": "0.0.11",
  "description": "Fathom analytics Nuxt module",
  "repository": "https://github.com/threenine/nuxt-fathom",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "defu": "^6.1.3",
    "fathom-client": "^3.6.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/kit": "^4.1.1",
    "@nuxt/schema": "^4.1.1",
    "@nuxt/scripts": "0.11.10",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^20.8.9",
    "@vue/test-utils": "^2.4.6",
    "changelogen": "^0.6.2",
    "eslint": "^9.33.0",
    "nuxt": "^4.1.1",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
